---
import '../styles/global.css';
import logoWhite from '../assets/logo_white.svg';
import sponsorsData from '../data/sponsors.json';

interface Props {
	title: string;
	description?: string;
	transparentNav?: boolean;
	noindex?: boolean;
}

const { title, description = "Koninklijke Toneelvereniging De Valk - Beleef theater dat raakt", transparentNav = false, noindex = false } = Astro.props;
const { sponsors } = sponsorsData;
---

<!doctype html>
<html lang="nl-BE">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Koninklijke Toneelvereniging De Valk</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
		
		<!-- Netlify Identity Widget -->
		<script src="https://unpkg.com/netlify-identity-widget@1.9.2/build/netlify-identity-widget.js"></script>
	</head>
	<body class="min-h-screen flex flex-col selection:bg-accent-gold selection:text-white overflow-x-hidden">
		
		<!-- Mobile Menu Overlay -->
		<div id="mobile-menu" class="fixed inset-0 bg-primary-text z-[100] hidden flex-col items-center justify-center w-full h-[100dvh] overflow-y-auto">
			<button id="menu-close" class="absolute top-8 right-8 text-bg-ivory p-4">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<nav class="flex flex-col items-center space-y-5 md:space-y-6 py-6 md:py-0">
				<a href="/" class="text-3xl md:text-4xl font-serif font-bold text-bg-ivory hover:text-accent-gold transition-colors">Home</a>
				<a href="/voorstellingen" class="text-3xl md:text-4xl font-serif font-bold text-bg-ivory hover:text-accent-gold transition-colors">Voorstellingen</a>
				<a href="/nieuws" class="text-3xl md:text-4xl font-serif font-bold text-bg-ivory hover:text-accent-gold transition-colors">Nieuws</a>
				<a href="/fotos" class="text-3xl md:text-4xl font-serif font-bold text-bg-ivory hover:text-accent-gold transition-colors">Foto's</a>
				<a href="/contact" class="text-3xl md:text-4xl font-serif font-bold text-bg-ivory hover:text-accent-gold transition-colors">Contact</a>
				<a href="/tickets" class="mt-2 px-8 py-3 bg-accent-gold text-bg-ivory text-3xl md:text-4xl font-serif font-bold hover:bg-white hover:text-accent-burgundy transition-all duration-300">Tickets</a>
			</nav>
			<div class="pt-8 md:pt-12 flex flex-col items-center space-y-4">
				<div class="w-12 h-px bg-accent-gold/30"></div>
				<span class="text-[10px] uppercase tracking-[0.4em] font-bold text-accent-gold">Brugge — Sinds 1945</span>
			</div>
	
		</div>

		<header id="main-header" class={`fixed top-0 w-full z-50 transition-[background-color,padding,border-color,color] duration-500 ${transparentNav ? 'bg-transparent py-6 md:py-8 text-white' : 'bg-bg-ivory/95 backdrop-blur-sm py-3 md:py-4 border-b border-ui-border text-primary-text'}`}>
			<nav class="container-custom flex justify-between items-center">
				<div class="flex flex-col">
					<a href="/" id="nav-logo" class="flex items-center gap-3 group">
						<img src={logoWhite.src} alt="De Valk Logo" id="nav-logo-img" class={`h-10 md:h-12 w-auto transition-all duration-500 ${transparentNav ? '' : 'brightness-0'}`} />
						<div class="flex flex-col items-start leading-none">
							<span id="nav-logo-accent" class={`text-2xl md:text-3xl font-serif font-bold tracking-tight transition-colors ${transparentNav ? 'text-white' : 'text-accent-burgundy'}`}>
								De Valk
							</span>
							<span id="nav-tagline" class={`text-[8px] md:text-[9px] tracking-[0.04em] font-sans font-bold uppercase transition-colors ${transparentNav ? 'text-white/60' : 'text-accent-gold/80'}`}>
								Koninklijke Toneelvereniging
							</span>
						</div>
					</a>
				</div>

				
				<ul class="hidden lg:flex space-x-7 xl:space-x-10 items-center">
					<li><a href="/" class="nav-link">Home</a></li>
					<li><a href="/voorstellingen" class="nav-link">Voorstellingen</a></li>
					<li><a href="/nieuws" class="nav-link">Nieuws</a></li>
					<li><a href="/fotos" class="nav-link">Foto's</a></li>
					<li><a href="/contact" class="nav-link">Contact</a></li>
					<li><a href="/tickets" class="px-6 py-3 bg-accent-gold text-white font-sans font-bold uppercase tracking-[0.2em] text-[11px] hover:bg-accent-burgundy transition-colors duration-500">Tickets</a></li>
				</ul>

				<button id="menu-toggle" class="lg:hidden p-2 -mr-2 transition-colors duration-500 aria-label='Open menu'">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M4 16h16" />
					</svg>
				</button>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-primary-text text-bg-ivory py-20 mt-auto">
			<div class="container-custom">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
					<div class="md:col-span-5">
						<div class="mb-6 flex flex-col items-start leading-none">
							<img src={logoWhite.src} alt="De Valk Logo" class="h-16 mb-4 w-auto" />
							<span class="text-3xl font-serif font-bold text-accent-gold tracking-tight">De Valk</span>
							<span class="text-[10px] tracking-[0.08em] font-sans font-bold uppercase text-bg-ivory/40 mt-1.5">Koninklijke Toneelvereniging</span>
						</div>
						<p class="text-bg-ivory/60 leading-relaxed max-w-md">
							Passie voor theater onder de Brugse kerktoren. Van een uitgebroed valkenei in 1945 tot een blijver in het culturele landschap.
						</p>
					</div>
					<div class="md:col-span-3">
						<h4 class="text-sm uppercase tracking-widest font-bold mb-6 text-accent-gold">Menu</h4>
						<ul class="space-y-4">
							<li><a href="/voorstellingen" class="text-bg-ivory/60 hover:text-white transition-colors">Alle Voorstellingen</a></li>
						<li><a href="/nieuws" class="text-bg-ivory/60 hover:text-white transition-colors">Laatste Nieuws</a></li>
						<li><a href="/fotos" class="text-bg-ivory/60 hover:text-white transition-colors">Foto's</a></li>
						<li><a href="/contact" class="text-bg-ivory/60 hover:text-white transition-colors">Contact</a></li>
							<li><a href="/tickets" class="text-bg-ivory/60 hover:text-white transition-colors">Tickets</a></li>
							<li><a href="/privacy" class="text-bg-ivory/60 hover:text-white transition-colors">Privacybeleid</a></li>
						</ul>
					</div>
					<div class="md:col-span-4">
						<h4 class="text-sm uppercase tracking-widest font-bold mb-6 text-accent-gold">Contact</h4>
						<p class="text-bg-ivory/60 mb-2">devalkbrugge@gmail.com</p>
						<p class="text-bg-ivory/60">Brugge, België</p>
					</div>
				</div>
			{sponsors && sponsors.length > 0 && (
				<div class="mt-16 pt-10 border-t border-white/5">
					<p class="text-[10px] uppercase tracking-[0.3em] font-bold text-bg-ivory/30 mb-6 text-center">Onze Sponsors</p>
					<div class="flex flex-wrap justify-center items-center gap-10 md:gap-16">
						{sponsors.map(partner => (
							<a href={partner.url} target="_blank" rel="noopener noreferrer">
								<img src={partner.logo} alt={partner.name} class="h-10 md:h-12 w-auto opacity-70 hover:opacity-100 transition-opacity" />
							</a>
						))}
					</div>
				</div>
			)}
				<div class="mt-10 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
					<p class="text-xs text-bg-ivory/40 uppercase tracking-widest">
						&copy; {new Date().getFullYear()} Koninklijke Toneelvereniging De Valk.
					</p>
					<div class="flex space-x-8">
						<a href="https://www.instagram.com/devalkbrugge/" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-bg-ivory/40 hover:text-white transition-colors">Instagram</a>
						<a href="https://www.facebook.com/toneelverenigingdevalk" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-bg-ivory/40 hover:text-white transition-colors">Facebook</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			declare global {
				interface Window {
					netlifyIdentity: any;
				}
			}

			if (window.netlifyIdentity) {
				window.netlifyIdentity.on("init", (user: any) => {
					if (!user) {
						window.netlifyIdentity.on("login", () => {
							document.location.href = "/admin/";
						});
					}
				});

				// Sluit de modal na wachtwoord instellen
				window.netlifyIdentity.on('close', () => {
					document.location.href = '/admin/';
				});
			}

			const header = document.getElementById('main-header');
			const navLogoAccent = document.getElementById('nav-logo-accent');
			const navTagline = document.getElementById('nav-tagline');
			const navLogoImg = document.getElementById('nav-logo-img');
			const menuToggle = document.getElementById('menu-toggle');
			const isTransparentInitial = header?.classList.contains('bg-transparent');

			function updateHeader() {
				if (!isTransparentInitial) return;

				if (window.scrollY > 50) {
					header?.classList.remove('bg-transparent', 'py-8', 'text-white');
					header?.classList.add('bg-bg-ivory/95', 'backdrop-blur-sm', 'py-4', 'border-b', 'border-ui-border', 'text-primary-text');
					
					navLogoAccent?.classList.remove('text-white');
					navLogoAccent?.classList.add('text-accent-burgundy');

					navTagline?.classList.remove('text-white/60');
					navTagline?.classList.add('text-accent-gold/80');

					navLogoImg?.classList.add('brightness-0');
				} else {
					header?.classList.add('bg-transparent', 'py-8', 'text-white');
					header?.classList.remove('bg-bg-ivory/95', 'backdrop-blur-sm', 'py-4', 'border-b', 'border-ui-border', 'text-primary-text');
					
					navLogoAccent?.classList.add('text-white');
					navLogoAccent?.classList.remove('text-accent-burgundy');

					navTagline?.classList.add('text-white/60');
					navTagline?.classList.remove('text-accent-gold/80');

					navLogoImg?.classList.remove('brightness-0');
				}
			}

			if (isTransparentInitial) {
				window.addEventListener('scroll', updateHeader);
				updateHeader();
			}

			const menuClose = document.getElementById('menu-close');
			const mobileMenu = document.getElementById('mobile-menu');

			menuToggle?.addEventListener('click', () => {
				mobileMenu?.classList.remove('hidden');
				mobileMenu?.classList.add('flex');
				document.body.style.overflow = 'hidden';
			});

			menuClose?.addEventListener('click', () => {
				mobileMenu?.classList.add('hidden');
				mobileMenu?.classList.remove('flex');
				document.body.style.overflow = '';
			});
		</script>
	</body>
</html>
