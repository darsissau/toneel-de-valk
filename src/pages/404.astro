---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden">
	<section class="min-h-screen flex items-center bg-bg-ivory pt-32 pb-20">
		<div class="container-custom text-center">
			<div class="fade-in max-w-2xl mx-auto">
				<span class="text-accent-gold uppercase tracking-[0.6em] text-[10px] font-bold mb-8 block">404</span>
				<h1 class="text-5xl md:text-8xl mb-12 tracking-tighter leading-none">Verdwenen<br/><span class="italic font-normal">in de coulissen</span></h1>
				<div class="w-16 h-px bg-accent-gold mx-auto mb-12"></div>
				<p class="text-primary-text/60 text-lg md:text-xl mb-16 leading-relaxed italic font-serif">
					"Het scherm is gevallen, maar deze pagina staat niet op het programma."
				</p>
				<a href="/" class="btn-theatre-outline">
					Terug naar Home
				</a>
			</div>
		</div>
	</section>
</Layout>
