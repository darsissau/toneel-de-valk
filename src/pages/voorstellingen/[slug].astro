---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import tickets from '../../data/tickets.json';
import { siWhatsapp, siFacebook, siX, siTelegram, siBluesky } from 'simple-icons';

export async function getStaticPaths() {
  const voorstellingen = await getCollection('voorstellingen');
  return voorstellingen.map(post => ({
    params: { slug: post.id || post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const MONTH_INDEX: Record<string, number> = {
  januari: 0, februari: 1, maart: 2, april: 3, mei: 4, juni: 5,
  juli: 6, augustus: 7, september: 8, oktober: 9, november: 10, december: 11,
};
const parseDateString = (str = ''): number => {
  const match = str.match(/(\d{1,2})\s+(\w+)\s+(\d{4})/);
  if (!match) return NaN;
  const [, day, month, year] = match;
  const monthIndex = MONTH_INDEX[month.toLowerCase()];
  if (monthIndex === undefined) return NaN;
  return new Date(Number(year), monthIndex, Number(day)).getTime();
};

const now = Date.now();
const times = (post.data.schedule ?? []).map((s) => s.time);
const dates = times.map(parseDateString).filter((t) => !isNaN(t));
const isPast = dates.length > 0 && Math.max(...dates) < now;

const { Content } = await render(post);
const { 
	title, 
	date, 
	image, 
	ticket_link, 
	ticket_label,
	pdf,
	pdf_label,
	author, 
	director, 
	location, 
	schedule,
	summary,
	support_label,
	support_partners,
} = post.data;

const pageUrl = new URL(`/voorstellingen/${post.id}/`, Astro.site).href;
const shareText = `${title} – Toneel De Valk`;
const u = encodeURIComponent(pageUrl);
const t = encodeURIComponent(shareText);
// LinkedIn staat niet in simple-icons (merkverzoek), dus eigen pad
const LINKEDIN_PATH = 'M4 9h3v11H4zM5.5 4a1.75 1.75 0 110 3.5 1.75 1.75 0 010-3.5zM10 9h3v1.6c.5-.9 1.7-1.8 3.4-1.8 3 0 3.6 2 3.6 4.6V20h-3v-5.8c0-1.4 0-3.1-1.9-3.1s-2.1 1.5-2.1 3V20h-3z';
const shareLinks = [
	{ name: 'WhatsApp', path: siWhatsapp.path, href: `https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}` },
	{ name: 'Facebook', path: siFacebook.path, href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
	{ name: 'X', path: siX.path, href: `https://x.com/intent/post?text=${t}&url=${u}` },
	{ name: 'LinkedIn', path: LINKEDIN_PATH, href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
	{ name: 'Telegram', path: siTelegram.path, href: `https://t.me/share/url?url=${u}&text=${t}` },
	{ name: 'Bluesky', path: siBluesky.path, href: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}` },
];
const qrCodes = [
	{ file: 'qr', label: 'Voorstelling' },
	...(pdf ? [{ file: 'qr-programma', label: 'Programmaboekje' }] : []),
];
// Deelbeeld 1200x630 uit og.jpg.ts; externe afbeeldingen (URL) gaan ongewijzigd mee
const ogImage = image.startsWith('/') ? `/voorstellingen/${post.id}/og.jpg` : image;
const ogImageSize: [number, number] | undefined = image.startsWith('/') ? [1200, 630] : undefined;
const mailHref = `mailto:?subject=${t}&body=${encodeURIComponent(`${summary}\n\n${pageUrl}`)}`;
// Google-zoekresultaten: één TheaterEvent per speeldatum (schema.org, JSON-LD)
// "21 November 2026 - 20:00 (Extra)" -> "2026-11-21T20:00:00+01:00" in Belgische tijd (winter/zomeruur)
const toIsoBrussels = (str: string) => {
	const m = str.match(/(\d{1,2})\s+(\w+)\s+(\d{4})(?:\D+(\d{1,2})[:.](\d{2}))?/);
	const month = m && MONTH_INDEX[m[2].toLowerCase()];
	if (!m || month === undefined) return undefined;
	const pad = (n: number) => String(n).padStart(2, '0');
	const day = `${m[3]}-${pad(month + 1)}-${pad(Number(m[1]))}`;
	if (!m[4]) return day;
	const instant = new Date(Date.UTC(Number(m[3]), month, Number(m[1]), Number(m[4]), Number(m[5])));
	const offset = new Intl.DateTimeFormat('en', { timeZone: 'Europe/Brussels', timeZoneName: 'longOffset' })
		.formatToParts(instant).find((p) => p.type === 'timeZoneName')!.value.replace('GMT', '') || '+00:00';
	return `${day}T${pad(Number(m[4]))}:${m[5]}:00${offset}`;
};
// Vaste zaal krijgt het volledige adres; een andere locatie enkel de naam uit het CMS
const place = !location || /magdalena/i.test(location)
	? {
		'@type': 'Place',
		name: 'Magdalenazaal (Ma/Z)',
		address: {
			'@type': 'PostalAddress',
			streetAddress: 'Magdalenastraat 27',
			postalCode: '8200',
			addressLocality: 'Brugge',
			addressRegion: 'West-Vlaanderen',
			addressCountry: 'BE',
		},
	}
	: { '@type': 'Place', name: location, address: location };
const devalk = { '@type': 'TheaterGroup', name: 'Koninklijke Toneelvereniging De Valk', url: Astro.site!.href };
const events = (schedule ?? []).flatMap(({ time }) => {
	const startDate = toIsoBrussels(time);
	if (!startDate) return [];
	return [{
		'@context': 'https://schema.org',
		'@type': 'TheaterEvent',
		name: title,
		description: summary,
		url: pageUrl,
		startDate,
		eventStatus: 'https://schema.org/EventScheduled',
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		location: place,
		image: [new URL(image, Astro.site).href, new URL(ogImage, Astro.site).href],
		organizer: devalk,
		performer: devalk,
		...(director && { director: { '@type': 'Person', name: director } }),
		...(author && { workPerformed: { '@type': 'CreativeWork', name: title, author: { '@type': 'Person', name: author } } }),
		offers: {
			'@type': 'Offer',
			url: ticket_link || tickets.ticket_link,
			price: tickets.ticket_price,
			priceCurrency: 'EUR',
			availability: 'https://schema.org/InStock',
		},
	}];
});
// "<" escapen zodat tekst uit het CMS de script-tag niet kan afsluiten
const eventsJsonLd = JSON.stringify(events).replace(/</g, '\\u003c');

const iconBtn = 'w-11 h-11 inline-flex items-center justify-center border border-primary-text/20 text-primary-text/70 hover:border-accent-gold hover:text-accent-gold transition-colors';
---

<Layout title={title} description={summary} image={ogImage} imageSize={ogImageSize} noindex={isPast}>
	{events.length > 0 && <script type="application/ld+json" set:html={eventsJsonLd} />}
	<article class="pt-32 md:pt-48 pb-20 md:pb-32">
		<div class="container-custom">
			<!-- Header with Vertical Poster Support -->
			<header class="mb-16 md:mb-32 grid lg:grid-cols-12 gap-10 md:gap-24 items-start">
				<div class="lg:col-span-7 order-2 lg:order-1">
					<p class="text-accent-gold font-bold uppercase tracking-[0.6em] text-[9px] md:text-[10px] mb-8 md:mb-12">{date}</p>
					<h1 class="text-5xl md:text-[100px] text-primary-text leading-[0.85] tracking-tighter mb-8 md:mb-12 break-word">{title}</h1>
					
					{summary && <p class="text-lg md:text-xl text-primary-text/80 mb-10 md:mb-12 max-w-2xl leading-relaxed">{summary}</p>}

					<div class="prose prose-lg prose-serif text-primary-text/60 italic mb-10 md:mb-12 max-w-xl border-l-2 border-accent-gold/20 pl-6 md:pl-8">
						{author && <p class="mb-2">Auteur: {author}</p>}
						{director && <p>Regie: {director}</p>}
					</div>

					<div class="flex flex-wrap gap-6 mb-12 md:mb-16">
						{ticket_link && (
							<a href={ticket_link} target="_blank" class="btn-theatre-primary w-full md:w-auto">
								{ticket_label || "Tickets kopen"}
							</a>
						)}
						{pdf && (
							<a href={pdf} target="_blank" rel="noopener" class="btn-theatre-outline w-full md:w-auto">
								{pdf_label || "Programmaboekje"}
							</a>
						)}
					</div>

					<div class="mb-10 md:mb-12">
						<p class="text-primary-text/40 text-[9px] md:text-[10px] uppercase tracking-widest font-bold mb-4">Deel deze voorstelling</p>
						<ul class="flex flex-wrap gap-2">
							<li class="hidden" id="share-native-item">
								<button type="button" id="share-native" data-title={title} data-text={shareText} data-url={pageUrl} class={iconBtn} aria-label="Delen via..." title="Delen via...">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
								</button>
							</li>
							{shareLinks.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer" class={iconBtn} aria-label={`Delen via ${link.name}`} title={link.name}>
										<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={link.path} /></svg>
									</a>
								</li>
							))}
							<li>
								<a href={mailHref} class={iconBtn} aria-label="Delen via e-mail" title="E-mail">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
								</a>
							</li>
							<li>
								<button type="button" id="share-copy" data-url={pageUrl} class={iconBtn} aria-label="Kopieer link" title="Kopieer link">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
								</button>
							</li>
							<li>
								<button type="button" id="qr-open" class={iconBtn} aria-label="Toon QR-codes" title="QR-codes">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
								</button>
							</li>
						</ul>
						<p id="share-copied" class="hidden mt-3 text-accent-gold text-[9px] md:text-[10px] uppercase tracking-widest font-bold" role="status">Link gekopieerd</p>
					</div>

					{location && (
						<div class="flex items-center gap-4 text-primary-text/40 text-[9px] md:text-[10px] uppercase tracking-widest font-bold">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
							</svg>
							{location}
						</div>
					)}
				</div>

				<div class="lg:col-span-5 order-1 lg:order-2">
					<div class="aspect-[2/3] overflow-hidden bg-gray-100 shadow-xl md:shadow-2xl relative group max-w-[450px] mx-auto lg:max-w-none">
						<img 
							src={image} 
							alt={title} 
							class="w-full h-full object-cover grayscale-[0.3] group-hover:grayscale-0 transition-all duration-1000" 
							onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=2000&auto=format&fit=crop';"
						/>
						<div class="absolute inset-0 border-[10px] md:border-[20px] border-white/5 pointer-events-none"></div>
					</div>
				</div>
			</header>

			<div class="grid lg:grid-cols-12 gap-16 md:gap-24 border-t border-ui-border pt-16 md:pt-24">
				<!-- Sidebar Info -->
				<aside class="lg:col-span-4 space-y-12 md:space-y-16">
					{schedule && schedule.length > 0 && (
						<div>
							<h3 class="text-accent-gold text-[9px] md:text-[10px] uppercase tracking-[0.4em] font-bold mb-6 md:mb-8">Data & Tijden</h3>
							<ul class="space-y-4 text-primary-text/70 font-serif text-lg">
								{schedule.map((item) => (
									<li class="border-b border-ui-border pb-2 last:border-0">{item.time}</li>
								))}
							</ul>
						</div>
					)}

					<div class="pt-4 md:pt-12">
						<a href="/voorstellingen" class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.4em] hover:text-accent-gold transition-colors inline-flex items-center gap-6">
							<span class="w-8 md:w-12 h-px bg-primary-text/20"></span> Terug naar programma
						</a>
					</div>
				</aside>

				<!-- Main Content -->
				<div class="lg:col-span-8">
					<div class="prose prose-lg md:prose-xl prose-serif max-w-none text-primary-text/80 leading-relaxed drop-cap">
						<Content />
					</div>

					{support_partners && support_partners.length > 0 && (
						<div class="mt-12 pt-8 border-t border-ui-border">
							<p class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.4em] text-primary-text/40 mb-6">
								{support_label || "Gerealiseerd met de steun van:"}
							</p>
							<div class="flex gap-8 items-center flex-wrap">
								{support_partners.map(partner => (
									<a href={partner.url} target="_blank" rel="noopener noreferrer" title={partner.name}>
										<img 
											src={partner.logo} 
											alt={partner.name} 
											class="h-[60px] w-auto object-contain"
										/>
									</a>
								))}
							</div>
						</div>
					)}
				</div>
			</div>
		</div>
	</article>

	<dialog id="qr-dialog" data-slug={post.id} class="m-auto p-8 md:p-10 bg-bg-ivory text-primary-text max-w-[calc(100vw-2rem)] backdrop:bg-black/60">
		<form method="dialog" class="absolute top-3 right-3">
			<button class="p-2 text-primary-text/50 hover:text-accent-gold transition-colors" aria-label="Sluiten">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
			</button>
		</form>
		<p class="text-accent-gold text-[9px] md:text-[10px] uppercase tracking-[0.4em] font-bold mb-2">QR-codes</p>
		<h2 class="font-serif text-2xl md:text-3xl mb-6 pr-8">{title}</h2>
		<div class="flex items-center gap-4 mb-6 md:mb-8 text-[9px] md:text-[10px] font-bold uppercase tracking-[0.3em]">
			<span class="text-primary-text/50">Achtergrond</span>
			<div class="flex border border-primary-text/20" role="group" aria-label="Achtergrond van de QR-code">
				<button type="button" data-qr-bg="" aria-pressed="true" class="px-3 py-2 aria-pressed:bg-primary-text aria-pressed:text-bg-ivory hover:text-accent-gold transition-colors">Wit</button>
				<button type="button" data-qr-bg="-transparant" aria-pressed="false" class="px-3 py-2 aria-pressed:bg-primary-text aria-pressed:text-bg-ivory hover:text-accent-gold transition-colors">Transparant</button>
			</div>
		</div>
		<div class="flex flex-col md:flex-row gap-8 md:gap-10">
			{qrCodes.map((qr) => (
				<div class="text-center">
					<p class="text-primary-text text-[10px] md:text-[11px] font-bold uppercase tracking-[0.3em] mb-3">{qr.label}</p>
					<img src={`/voorstellingen/${post.id}/${qr.file}.svg`} data-qr-file={qr.file} data-ext="svg" alt={`QR-code ${qr.label.toLowerCase()} ${title}`} width="240" height="240" loading="lazy" class="w-[220px] md:w-[240px] aspect-square bg-white mx-auto" />
					<div class="flex gap-6 justify-center mt-4 text-[10px] md:text-[11px] font-bold uppercase tracking-[0.3em] text-primary-text/70">
						{['svg', 'png'].map((ext) => (
							<a href={`/voorstellingen/${post.id}/${qr.file}.${ext}`} data-qr-file={qr.file} data-ext={ext} download={`${qr.file}-${post.id}.${ext}`} class="hover:text-accent-gold transition-colors">{ext.toUpperCase()}</a>
						))}
					</div>
				</div>
			))}
		</div>
		<p id="qr-bg-hint" class="hidden mt-6 text-center text-primary-text/50 text-[11px] italic">Transparant scant enkel goed op een lichte achtergrond.</p>
	</dialog>
</Layout>

<script>
	// QR-popup met de codes van de voorstelling en (indien aanwezig) het programmaboekje
	const dialog = document.getElementById('qr-dialog') as HTMLDialogElement;
	document.getElementById('qr-open')?.addEventListener('click', () => dialog.showModal());
	dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); }); // klik op achtergrond sluit

	// Wit of transparant: wisselt voorbeeld en downloads naar de "-transparant" bestanden
	const slug = dialog.dataset.slug!;
	const qrBase = `/voorstellingen/${slug}/`;
	dialog.querySelectorAll<HTMLButtonElement>('[data-qr-bg]').forEach((btn) => btn.addEventListener('click', () => {
		const suffix = btn.dataset.qrBg!;
		dialog.querySelectorAll<HTMLButtonElement>('[data-qr-bg]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
		dialog.querySelectorAll<HTMLElement>('[data-qr-file]').forEach((el) => {
			const name = `${el.dataset.qrFile}${suffix}`;
			const url = `${qrBase}${name}.${el.dataset.ext}`;
			if (el instanceof HTMLImageElement) {
				el.src = url;
				el.classList.toggle('bg-white', !suffix);
			} else if (el instanceof HTMLAnchorElement) {
				el.href = url;
				el.download = `${name}-${slug}.${el.dataset.ext}`;
			}
		});
		document.getElementById('qr-bg-hint')?.classList.toggle('hidden', !suffix);
	}));

	// Native deelmenu van de telefoon: bereikt ook Instagram, Messenger, Signal, sms, ...
	const nativeBtn = document.getElementById('share-native') as HTMLButtonElement | null;
	if (nativeBtn && navigator.share) {
		document.getElementById('share-native-item')?.classList.remove('hidden');
		nativeBtn.addEventListener('click', () => {
			const { title, text, url } = nativeBtn.dataset;
			navigator.share({ title, text, url }).catch(() => {});
		});
	}

	const copyBtn = document.getElementById('share-copy') as HTMLButtonElement | null;
	copyBtn?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(copyBtn.dataset.url!);
			document.getElementById('share-copied')?.classList.remove('hidden');
		} catch {
			prompt('Kopieer deze link:', copyBtn.dataset.url);
		}
	});
</script>

<style is:global>
	.drop-cap p:first-of-type::first-letter {
		font-family: var(--font-serif);
		float: left;
		font-size: 5rem;
		line-height: 4rem;
		padding-top: 4px;
		padding-right: 12px;
		padding-left: 3px;
		color: #C8A24A;
		font-weight: 700;
	}
</style>