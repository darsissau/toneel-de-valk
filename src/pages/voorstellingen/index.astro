---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const voorstellingen = await getCollection('voorstellingen');

const monthMap: { [key: string]: number } = {
  'januari': 0, 'februari': 1, 'maart': 2, 'april': 3, 'mei': 4, 'juni': 5,
  'juli': 6, 'augustus': 7, 'september': 8, 'oktober': 9, 'november': 10, 'december': 11
};

const parseTheatreDate = (dateStr: string) => {
  const parts = dateStr.toLowerCase().split(' ');
  if (parts.length === 2) {
    const month = monthMap[parts[0]];
    const year = parseInt(parts[1]);
    if (month !== undefined && !isNaN(year)) {
      return new Date(year, month, 1);
    }
  }
  return new Date(dateStr.split('-').reverse().join('-'));
};

const sortedVoorstellingenAsc = voorstellingen.sort((a, b) => {
  const dateA = parseTheatreDate(a.data.date);
  const dateB = parseTheatreDate(b.data.date);
  return dateA.getTime() - dateB.getTime();
});

const getSeason = (date: Date) => {
  return date.getMonth() >= 6 ? date.getFullYear() : date.getFullYear() - 1;
};

const seasons = new Map<number, any[]>();
sortedVoorstellingenAsc.forEach(v => {
  const d = parseTheatreDate(v.data.date);
  const season = getSeason(d);
  if (!seasons.has(season)) seasons.set(season, []);
  seasons.get(season)!.push(v);
});

const sortedSeasons = Array.from(seasons.keys()).sort((a, b) => b - a);
const groupedVoorstellingen = sortedSeasons.flatMap(season => seasons.get(season)!);
---

<Layout title="Voorstellingen">
	<section class="pt-32 md:pt-48 pb-20 md:pb-32 bg-bg-ivory">
		<div class="container-custom">
			<div class="max-w-3xl">
				<p class="text-accent-gold uppercase tracking-[0.5em] text-[9px] md:text-[10px] font-bold mb-6 md:mb-10">Archief & Toekomst</p>
				<h1 class="text-5xl md:text-8xl mb-8 md:mb-12 tracking-tighter leading-[0.85] break-word">Onze<br/><span class="italic font-normal">Voorstellingen</span></h1>
				<div class="w-16 h-1 bg-accent-gold"></div>
			</div>
		</div>
	</section>

	<section class="py-20 md:py-32 bg-white">
		<div class="container-custom">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16 md:gap-y-32">
				{groupedVoorstellingen.map((item) => (
					<a href={`/voorstellingen/${item.id || item.slug}`} class="theatre-card group flex flex-col md:flex-row gap-6 lg:gap-8 items-center md:items-start">
						<div class="theatre-card-image bg-primary-text/5 w-2/3 md:w-2/5 shrink-0 order-1 md:order-1">
							<img 
								src={item.data.image} 
								alt={item.data.title} 
								onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=1000&auto=format&fit=crop';"
							/>
						</div>
						<div class="theatre-card-content text-center md:text-left order-2 md:order-2 md:pt-4">
							<p class="text-accent-gold text-[10px] uppercase tracking-[0.2em] font-bold mb-4">{item.data.date}</p>
							<h2 class="text-3xl mb-6 group-hover:text-accent-gold transition-colors tracking-tight leading-tight">{item.data.title}</h2>
							<p class="text-primary-text/40 text-xs uppercase tracking-widest font-bold flex items-center justify-center md:justify-start gap-4">
								Ontdek <span class="w-8 h-px bg-primary-text/10 group-hover:bg-accent-gold group-hover:w-12 transition-all"></span>
							</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>
