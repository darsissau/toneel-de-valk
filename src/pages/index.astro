---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import koenraadImage from '../assets/koenraad_right.png';
import koenraadMobileImage from '../assets/koenraad-mobile.png';
import logoWhite from '../assets/logo_white.svg';

const voorstellingen = await getCollection('voorstellingen');
const nieuws = await getCollection('nieuws');

const monthMap: { [key: string]: number } = {
  'januari': 0, 'februari': 1, 'maart': 2, 'april': 3, 'mei': 4, 'juni': 5,
  'juli': 6, 'augustus': 7, 'september': 8, 'oktober': 9, 'november': 10, 'december': 11
};

const parseTheatreDate = (dateStr: string) => {
  const parts = dateStr.toLowerCase().split(' ');
  if (parts.length === 2) {
    const month = monthMap[parts[0]];
    const year = parseInt(parts[1]);
    if (month !== undefined && !isNaN(year)) {
      return new Date(year, month, 1);
    }
  }
  // Fallback for other formats
  return new Date(dateStr.split('-').reverse().join('-'));
};

const sortedVoorstellingenAsc = voorstellingen.sort((a, b) => {
  const dateA = parseTheatreDate(a.data.date);
  const dateB = parseTheatreDate(b.data.date);
  return dateA.getTime() - dateB.getTime();
});

const getSeason = (date: Date) => {
  return date.getMonth() >= 6 ? date.getFullYear() : date.getFullYear() - 1;
};

const seasons = new Map<number, any[]>();
sortedVoorstellingenAsc.forEach(v => {
  const d = parseTheatreDate(v.data.date);
  const season = getSeason(d);
  if (!seasons.has(season)) seasons.set(season, []);
  seasons.get(season)!.push(v);
});

const sortedSeasons = Array.from(seasons.keys()).sort((a, b) => b - a);
const groupedVoorstellingen = sortedSeasons.flatMap(season => seasons.get(season)!);

const today = new Date();
// Zoek de eerste voorstelling die vandaag of in de toekomst is
let volgendeVoorstelling = sortedVoorstellingenAsc.find(v => {
  const vDate = parseTheatreDate(v.data.date);
  // Zet de datum naar het einde van de maand voor de check
  const endOfMonth = new Date(vDate.getFullYear(), vDate.getMonth() + 1, 0);
  return endOfMonth >= today;
});

// Als er geen toekomstige voorstellingen zijn, toon dan de meest recente uit het verleden
if (!volgendeVoorstelling && sortedVoorstellingenAsc.length > 0) {
  volgendeVoorstelling = sortedVoorstellingenAsc[sortedVoorstellingenAsc.length - 1];
}

const sortedVoorstellingen = groupedVoorstellingen.slice(0, 2);

const sortedNieuws = nieuws.sort((a, b) => {
  const dateA = new Date(a.data.date.split('-').reverse().join('-'));
  const dateB = new Date(b.data.date.split('-').reverse().join('-'));
  return dateB.getTime() - dateA.getTime();
}).slice(0, 3);
---

<Layout title="Home" transparentNav={true}>
	<section class="relative h-svh md:h-screen flex items-end overflow-hidden bg-primary-text">
		<div class="absolute inset-0 z-0">
			<picture>
				<source media="(min-width: 768px)" srcset={koenraadImage.src} />
				<img src={koenraadMobileImage.src} class="w-full h-full object-cover object-left grayscale opacity-40" alt="Theatre stage" />
			</picture>
			<div class="absolute inset-0 bg-gradient-to-t from-primary-text via-transparent to-transparent"></div>
		</div>
		
		<div class="container-custom relative z-10 pb-16 md:pb-32 w-full">
			<div class="fade-in max-w-4xl">
				<h1 class="text-poster text-bg-ivory mb-8 md:mb-12 leading-[0.9] tracking-tight">
					Blijf <br class="md:hidden"/>verwonderd!
				</h1>
				<div class="flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-12">
					<a href={volgendeVoorstelling ? `/voorstellingen/${volgendeVoorstelling.id}` : "/voorstellingen"} class="btn-theatre-primary w-full md:w-auto">
						Onze volgende productie
					</a>
					<p class="text-bg-ivory/40 text-[9px] md:text-[10px] uppercase tracking-[0.3em] max-w-sm leading-loose">
						Sinds 1945<br/> drama, humor, spanning en schoonheid op de planken
					</p>
				</div>
			</div>
		</div>
	</section>

	

	<section class="act-section bg-white border-y border-ui-border">
		<div class="container-custom">
			<div class="max-w-xl mb-16 md:mb-24">
				<h2 class="text-4xl md:text-6xl mb-8">Programma</h2>
				<p class="text-primary-text/50 text-sm tracking-wide leading-relaxed">
					Een seizoen vol nostalgie en actualiteit.
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-24 w-full">
				{sortedVoorstellingen.map((item) => (
					<a href={`/voorstellingen/${item.id}`} class="theatre-card group flex flex-col md:flex-row gap-6 lg:gap-8 items-center md:items-start">
						<div class="theatre-card-image bg-primary-text/5 w-2/3 md:w-1/2 shrink-0">
							<img src={item.data.image} alt={item.data.title} />
							<div class="absolute inset-0 bg-accent-burgundy/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
						</div>
						<div class="theatre-card-content text-center md:text-left md:pt-4 w-full">
							<h3 class="text-2xl mb-2 group-hover:text-accent-gold transition-colors">{item.data.title}</h3>
							<p class="text-primary-text/40 text-[10px] uppercase tracking-[0.2em] font-bold">{item.data.date}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="act-section bg-bg-ivory relative overflow-hidden">
		<div class="absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none">
			<img src={logoWhite.src} alt="" class="w-[80vw] max-w-[800px] h-auto invert" />
		</div>
		<div class="container-custom text-center relative z-10">
			<span class="text-accent-gold text-[10px] uppercase tracking-[0.6em] mb-12 block">Onze Broedplaats</span>
			<h2 class="text-4xl md:text-7xl mb-16 italic font-normal tracking-tight leading-tight max-w-4xl mx-auto">
				Elk seizoen opnieuw in november en maart legt DE VALK een theaterlijk ei
			</h2>
			<div class="w-12 h-px bg-primary-text/20 mx-auto mb-16"></div>
			<p class="text-primary-text/60 max-w-xl mx-auto text-sm leading-loose uppercase tracking-widest">
				en is daarmee een blijver in het Brugse toneellandschap.
			</p>
		</div>
	</section>
</Layout>

<style>
	.text-poster { 
		font-size: clamp(2rem, 12vw, 4.5rem); 
	}
	@media (min-width: 768px) {
		.text-poster {
			font-size: clamp(4rem, 15vw, 12rem);
		}
	}
</style>
