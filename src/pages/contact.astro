---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" transparentNav={true}>
	<!-- Hero Section: Clean & Bold -->
	<section class="relative h-[50svh] md:h-[60vh] flex items-center bg-primary-text overflow-hidden">
		<div class="absolute inset-0 z-0">
			<!-- Pure image, no heavy digital gradient -->
			<!-- <img 
				src="https://images.unsplash.com/photo-1503095396549-807a8bc36674?q=80&w=2400&auto=format&fit=crop" 
				class="w-full h-full object-cover grayscale opacity-40"
				alt="Theatre backdrop"
			/> -->
			<!-- Single solid overlay for text contrast if needed -->
			<div class="absolute inset-0 bg-primary-text/20"></div>
		</div>
		
		<div class="container-custom relative z-10 w-full">
			<div class="fade-in pt-12 md:pt-0">
				<span class="text-accent-gold uppercase tracking-[0.6em] text-[9px] md:text-[10px] font-bold mb-4 md:mb-6 block">RESERVATIES & VRAGEN</span>
				<h1 class="text-6xl md:text-9xl text-bg-ivory leading-none tracking-tighter uppercase">
					CON<span class="italic font-normal">TACT</span>
				</h1>
			</div>
		</div>
	</section>

	<!-- Main Content: Stable Two-Column Layout -->
	<section class="py-16 md:py-32 bg-bg-ivory">
		<div class="container-custom">
			<div class="grid lg:grid-cols-12 gap-12 lg:gap-24">
				
				<!-- Form Side -->
				<div class="lg:col-span-7">
					<h2 class="text-2xl md:text-4xl font-serif mb-6 md:mb-8 tracking-tight">Laat van u horen.</h2>
					<p class="text-primary-text/60 mb-10 md:mb-16 leading-relaxed italic border-l-2 border-accent-gold/20 pl-6 text-sm md:text-base">
						"Elke ontmoeting begint met een eerste woord. Wij kijken daarnaar uit."
					</p>
					
					<form name="contact" method="POST" action="/bedankt" data-netlify="true" netlify-honeypot="bot-field" class="space-y-10 md:space-y-12">
						<input type="hidden" name="form-name" value="contact" />
						<p class="hidden">
							<label>Don't fill this out if you're human: <input name="bot-field" /></label>
						</p>

						<div class="group border-b border-primary-text/10 focus-within:border-accent-gold transition-colors pb-4">
							<label for="name" class="block text-[10px] uppercase tracking-widest font-bold text-primary-text/30 mb-2">Naam</label>
							<input type="text" id="name" name="name" required class="w-full bg-transparent py-2 outline-none text-lg md:text-xl font-serif placeholder:text-primary-text/30" placeholder="Naam Voornaam" />
						</div>
						
						<div class="group border-b border-primary-text/10 focus-within:border-accent-gold transition-colors pb-4">
							<label for="email" class="block text-[10px] uppercase tracking-widest font-bold text-primary-text/30 mb-2">Email</label>
							<input type="email" id="email" name="email" required class="w-full bg-transparent py-2 outline-none text-lg md:text-xl font-serif placeholder:text-primary-text/30" placeholder="uw@email.be" />
						</div>
						
						<div class="group border-b border-primary-text/10 focus-within:border-accent-gold transition-colors pb-4">
							<label for="message" class="block text-[10px] uppercase tracking-widest font-bold text-primary-text/30 mb-2">Bericht</label>
							<textarea id="message" name="message" required rows="1" class="w-full bg-transparent py-2 outline-none text-lg md:text-xl font-serif placeholder:text-primary-text/30 resize-none" placeholder="Hoe kunnen we u helpen?"></textarea>
						</div>
						
						<div class="pt-4 md:pt-8">
							<button type="submit" class="btn-theatre-primary w-full md:w-auto px-16 py-5">
								Verzenden
							</button>
						</div>
					</form>
				</div>

				<!-- Info Side -->
				<aside class="lg:col-span-5 space-y-12 md:space-y-16">
					<div class="bg-white p-8 md:p-12 border border-primary-text/5 shadow-sm">
						<h3 class="text-accent-gold text-[10px] uppercase tracking-[0.4em] font-bold mb-8 md:mb-12">INFORMATIE</h3>
						
						<div class="space-y-10 md:space-y-12">
							<div>
								<span class="text-[9px] uppercase tracking-widest text-primary-text/30 mb-3 md:mb-4 block font-bold">Email</span>
								<a href="mailto:devalkbrugge@gmail.com" class="text-xl md:text-2xl font-serif hover:text-accent-gold transition-colors block">devalkbrugge@gmail.com</a>
							</div>

							<div>
								<span class="text-[9px] uppercase tracking-widest text-primary-text/30 mb-3 md:mb-4 block font-bold">Vaste Speelplek</span>
								<p class="text-xl md:text-2xl font-serif leading-tight">
									Magdalenazaal<br />
									<span class="text-primary-text/40">Brugge, BE</span>
								</p>
							</div>

							<div>
								<span class="text-[9px] uppercase tracking-widest text-primary-text/30 mb-4 md:mb-6 block font-bold">Social Media</span>
								<div class="flex gap-6 md:gap-8">
									<a href="https://www.instagram.com/devalkbrugge/" target="_blank" rel="noopener noreferrer" class="text-[10px] md:text-[11px] font-bold uppercase tracking-widest border-b border-accent-gold/20 hover:border-accent-gold transition-colors pb-1">Instagram</a>
									<a href="https://www.facebook.com/toneelverenigingdevalk" target="_blank" rel="noopener noreferrer" class="text-[10px] md:text-[11px] font-bold uppercase tracking-widest border-b border-accent-gold/20 hover:border-accent-gold transition-colors pb-1">Facebook</a>
								</div>
							</div>
						</div>
					</div>
				</aside>

			</div>
		</div>
	</section>
</Layout>
