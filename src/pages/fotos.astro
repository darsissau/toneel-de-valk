---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Foto's" transparentNav={true} noindex={true}>
	<!-- Hero Section -->
	<section class="relative h-[50svh] md:h-[60vh] flex items-center bg-primary-text overflow-hidden">
		<div class="absolute inset-0 z-0">
			<div class="absolute inset-0 bg-primary-text/20"></div>
		</div>
		
		<div class="container-custom relative z-10 w-full">
			<div class="fade-in pt-12 md:pt-0">
				<span class="text-accent-gold uppercase tracking-[0.6em] text-[9px] md:text-[10px] font-bold mb-4 md:mb-6 block">Sfeerbeelden</span>
				<h1 class="text-6xl md:text-9xl text-bg-ivory leading-none tracking-tighter uppercase">
					FO<span class="italic font-normal">TO'S</span>
				</h1>
			</div>
		</div>
	</section>

	<!-- Content Section -->
	<section class="py-16 md:py-32 bg-bg-ivory">
		<div class="container-custom">
			<div class="max-w-4xl mx-auto text-center mb-16 md:mb-24">
				<h2 class="text-3xl md:text-5xl font-serif mb-6 tracking-tight">Kijkje achter de schermen</h2>
				<p class="text-primary-text/60 leading-relaxed italic max-w-xl mx-auto text-sm md:text-base">
					"Theater is vluchtig, maar de herinnering blijft. Blader door onze albums en herbeleef de magie van onze producties."
				</p>
			</div>

			<div id="photos-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
				<div class="col-span-full py-20 text-center">
					<p class="text-primary-text/40 text-sm uppercase tracking-widest">Album wordt geladen...</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Lightbox Carousel -->
	<div id="photo-lightbox" class="hidden fixed inset-0 z-[110] bg-primary-text/95 backdrop-blur-sm items-center justify-center p-4 md:p-8">
		<button id="lightbox-close" class="absolute top-4 right-4 md:top-6 md:right-6 text-bg-ivory/70 hover:text-white p-3 transition-colors z-10" aria-label="Sluiten">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<div class="relative w-full h-full flex items-center justify-center">
			<div class="absolute inset-y-0 left-0 right-0 flex items-center justify-between pointer-events-none">
				<button id="lightbox-prev" class="pointer-events-auto p-4 md:p-5 text-bg-ivory/70 hover:text-white transition-colors" aria-label="Vorige foto">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
					</svg>
				</button>
				<button id="lightbox-next" class="pointer-events-auto p-4 md:p-5 text-bg-ivory/70 hover:text-white transition-colors" aria-label="Volgende foto">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
					</svg>
				</button>
			</div>

			<img id="lightbox-img" class="max-h-full max-w-full object-contain shadow-2xl" alt="" />
		</div>

		<div id="lightbox-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-bg-ivory/60 text-xs uppercase tracking-widest font-bold"></div>
	</div>

	<script>
		const grid = document.getElementById('photos-grid');
		const lightbox = document.getElementById('photo-lightbox');
		const lightboxImg = document.getElementById('lightbox-img');
		const lightboxCounter = document.getElementById('lightbox-counter');
		const lightboxClose = document.getElementById('lightbox-close');
		const lightboxPrev = document.getElementById('lightbox-prev');
		const lightboxNext = document.getElementById('lightbox-next');

		let photos = [];
		let current = 0;

		const thumbFor = (url) => url.replace(/=w\d+-h\d+-k-no/, '=w400-h533-k-no');

		async function loadPhotos() {
			const endpoint = '/api/photos';
			try {
				const res = await fetch(endpoint);
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const data = await res.json();
				render(data.photos);
			} catch {
				grid.innerHTML =
					'<div class="col-span-full py-20 text-center text-primary-text/40 text-sm uppercase tracking-widest">Kon het album niet laden. Probeer later opnieuw.</div>';
			}
		}

		function makeItem(src, index) {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.setAttribute('aria-label', `Foto ${index + 1} vergroten`);
			btn.className =
				'group block overflow-hidden bg-primary-text/5 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-accent-gold w-full';
			const img = document.createElement('img');
			img.src = src;
			img.alt = `Foto ${index + 1}`;
			img.loading = 'lazy';
			img.decoding = 'async';
			img.fetchpriority = index < 4 ? 'high' : 'low';
			img.className =
				'w-full aspect-[3/4] object-cover grayscale-[0.2] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700';
			btn.appendChild(img);
			btn.addEventListener('click', () => openLightbox(index));
			return btn;
		}

		function render(dataPhotos) {
			grid.innerHTML = '';
			if (!Array.isArray(dataPhotos) || dataPhotos.length === 0) {
				grid.innerHTML =
					'<div class="col-span-full py-20 text-center text-primary-text/40 text-sm uppercase tracking-widest">Geen foto\'s gevonden.</div>';
				return;
			}
			photos = dataPhotos;
			photos.forEach((url, i) => {
				grid.appendChild(makeItem(thumbFor(url), i));
			});
		}

		function openLightbox(index) {
			current = index;
			updateLightbox();
			lightbox.classList.remove('hidden');
			lightbox.classList.add('flex');
			document.body.style.overflow = 'hidden';
		}

		function closeLightbox() {
			lightbox.classList.add('hidden');
			lightbox.classList.remove('flex');
			document.body.style.overflow = '';
		}

		function updateLightbox() {
			lightboxImg.src = photos[current];
			lightboxImg.alt = `Foto ${current + 1}`;
			lightboxCounter.textContent = `${current + 1} / ${photos.length}`;
		}

		function nextPhoto() {
			current = (current + 1) % photos.length;
			updateLightbox();
		}

		function prevPhoto() {
			current = (current - 1 + photos.length) % photos.length;
			updateLightbox();
		}

		lightboxClose.addEventListener('click', closeLightbox);
		lightboxPrev.addEventListener('click', prevPhoto);
		lightboxNext.addEventListener('click', nextPhoto);
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) closeLightbox();
		});

		document.addEventListener('keydown', (e) => {
			if (lightbox.classList.contains('hidden')) return;
			if (e.key === 'Escape') closeLightbox();
			if (e.key === 'ArrowRight') nextPhoto();
			if (e.key === 'ArrowLeft') prevPhoto();
		});

		loadPhotos();
	</script>
</Layout>