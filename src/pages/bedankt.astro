---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bedankt" transparentNav={false}>
	<section class="min-h-[70svh] flex items-center bg-bg-ivory">
		<div class="container-custom text-center">
			<div class="fade-in max-w-2xl mx-auto">
				<span class="text-accent-gold uppercase tracking-[0.6em] text-[10px] font-bold mb-8 block">BERICHT ONTVANGEN</span>
				<h1 class="text-5xl md:text-8xl mb-12 tracking-tighter leading-none">Bedankt voor<br/><span class="italic font-normal">uw bericht</span></h1>
				<div class="w-16 h-px bg-accent-gold mx-auto mb-12"></div>
				<p class="text-primary-text/60 text-lg md:text-xl mb-16 leading-relaxed italic font-serif">
					"Het gordijn is gevallen voor uw verzending. Wij nemen zo snel mogelijk contact met u op."
				</p>
				<a href="/" class="btn-theatre-outline">
					Terug naar Home
				</a>
			</div>
		</div>
	</section>
</Layout>
